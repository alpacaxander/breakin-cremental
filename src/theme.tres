[resource]
default_font_size = 18
Button/colors/font_color = Color(1, 1, 0.81, 1)
Button/colors/font_hover_color = Color(0.922, 0.859, 0.341, 1)
Button/colors/font_pressed_color = Color(1, 1, 0.81, 1)
Button/colors/font_disabled_color = Color(0.33, 0.33, 0.655, 1)
Button/styles/normal = SubResource("btn")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_hover")
CheckButton/colors/font_color = Color(1, 1, 0.81, 1)
CheckButton/colors/font_hover_color = Color(0.922, 0.859, 0.341, 1)
Label/colors/font_color = Color(1, 1, 0.81, 1)
