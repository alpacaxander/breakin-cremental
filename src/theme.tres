[gd_resource type="Theme" load_steps=6 format=3]

; Project default theme (project.godot gui/theme/custom). Colors from docs/palette.md:
; base 000020, cabinet trim 2e2e5c, dead 5454a7, gold trim ebdb57, text ffffcf.

