[gd_resource type="Theme" load_steps=14 format=3]

; Project default theme (project.godot gui/theme/custom). Controls live on a 640x360 Control scaled 2x (src/ui.gd),
; so the 3x5 bitmap font at size 5 and the ui_* nine-patches (3px corners) land on the sprite grid.
; Button is the chrome button; the "Mint" variation is the lamp button. Colors from docs/palette.md.

[ext_resource type="FontFile" path="res://assets/pixel/png/font_3x5.fnt" id="font"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_button_chrome.png" id="chrome"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_button_chrome_hot.png" id="chrome_hot"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_button_mint.png" id="mint"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_button_mint_hot.png" id="mint_hot"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_button_mint_dim.png" id="mint_dim"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_panel.png" id="panel"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_toggle_on.png" id="toggle_on"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_toggle_off.png" id="toggle_off"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_slider_track.png" id="track"]
[ext_resource type="Texture2D" path="res://assets/pixel/png/ui_slider_knob.png" id="knob"]

[sub_resource type="StyleBoxTexture" id="chrome"]
texture = ExtResource("chrome")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0

[sub_resource type="StyleBoxTexture" id="chrome_hot"]
texture = ExtResource("chrome_hot")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0

[sub_resource type="StyleBoxTexture" id="mint"]
texture = ExtResource("mint")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0

[sub_resource type="StyleBoxTexture" id="mint_hot"]
texture = ExtResource("mint_hot")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0

[sub_resource type="StyleBoxTexture" id="mint_dim"]
texture = ExtResource("mint_dim")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0

[sub_resource type="StyleBoxTexture" id="panel"]
texture = ExtResource("panel")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxTexture" id="track"]
texture = ExtResource("track")
axis_stretch_horizontal = 2
content_margin_top = 2.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxEmpty" id="empty"]

[resource]
default_font = ExtResource("font")
default_font_size = 5
Button/colors/font_color = Color(1, 1, 0.81, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(1, 1, 0.81, 1)
Button/colors/font_disabled_color = Color(0.33, 0.33, 0.655, 1)
Button/styles/normal = SubResource("chrome")
Button/styles/hover = SubResource("chrome_hot")
Button/styles/pressed = SubResource("chrome_hot")
Button/styles/disabled = SubResource("chrome")
Button/styles/focus = SubResource("empty")
Mint/base_type = &"Button"
Mint/colors/font_disabled_color = Color(0.008, 0.576, 0.42, 1)
Mint/styles/normal = SubResource("mint")
Mint/styles/hover = SubResource("mint_hot")
Mint/styles/pressed = SubResource("mint_hot")
Mint/styles/disabled = SubResource("mint_dim")
CheckButton/icons/checked = ExtResource("toggle_on")
CheckButton/icons/unchecked = ExtResource("toggle_off")
CheckButton/styles/normal = SubResource("empty")
CheckButton/styles/hover = SubResource("empty")
CheckButton/styles/pressed = SubResource("empty")
CheckButton/styles/focus = SubResource("empty")
HSlider/icons/grabber = ExtResource("knob")
HSlider/icons/grabber_highlight = ExtResource("knob")
HSlider/icons/grabber_disabled = ExtResource("knob")
HSlider/styles/slider = SubResource("track")
HSlider/styles/grabber_area = SubResource("empty")
HSlider/styles/grabber_area_highlight = SubResource("empty")
Label/colors/font_color = Color(1, 1, 0.81, 1)
Label/constants/line_spacing = 2
PanelContainer/styles/panel = SubResource("panel")
