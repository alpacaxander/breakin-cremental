## Plays one cue from assets/audio/wav/<name>.wav. Cues are generated by assets/audio/gen.mjs; demo.html there lists them.
extends Node

const DIR := "res://assets/audio/wav/%s.wav"


## One-shot under the scene root, so it outlives whatever fired it and plays through a pause. pitch: ladders reuse one sample.
static func play(name: String, pitch := 1.0, delay := 0.0) -> void:
	var tree: SceneTree = Engine.get_main_loop()
	if delay > 0:
		tree.create_timer(delay).timeout.connect(func(): play(name, pitch))
		return
	var p := _player(name, pitch)
	p.process_mode = Node.PROCESS_MODE_ALWAYS
	p.autoplay = true
	p.finished.connect(p.queue_free)
	tree.root.add_child.call_deferred(p)  # deferred: a cue fired from a _ready chain would find the root busy


## Looping cue as a child of parent: it pauses and stops with it. Loop cues have edit/loop_mode=1 in their .import.
static func loop(parent: Node, name: String) -> AudioStreamPlayer:
	var p := _player(name, 1.0)
	p.autoplay = true  # starts on _ready, so the parent may still be outside the tree
	parent.add_child(p)
	return p


## Stops every cue, then quits a tick later: a stream still mixing at exit logs a leaked playback.
static func quit() -> void:
	var tree: SceneTree = Engine.get_main_loop()
	tree.paused = true  # else the round keeps firing cues during the wait. ponytail: a delayed cue already timed can still slip in
	for p in tree.root.find_children("*", "AudioStreamPlayer", true, false):
		p.stop()
	tree.create_timer(0.1).timeout.connect(tree.quit)


## n semitones up as a pitch_scale.
static func st(n: int) -> float:
	return pow(2.0, n / 12.0)


static func _player(name: String, pitch: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.stream = load(DIR % name)
	p.pitch_scale = pitch
	return p
